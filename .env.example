# Для Docker Compose. Значения по умолчанию работают без файла .env.
IPR_URL=http://ipr:8003
VLP_URL=http://vlp:8002
NODAL_URL=http://nodal:8004
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://[::1]:3000

# Optional local access: used only with compose.local.yaml.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# Optional integration with an existing reverse proxy Docker network.
PROXY_NETWORK=public_proxy
